{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FS-DBI extraction schema (silver standard)",
  "type": "object",
  "required": ["entities", "violation_category", "case_outcome"],
  "additionalProperties": false,
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "text"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["SERVICE_PROVIDER", "END_USER", "TACTIC", "DOCUMENT", "JURISDICTION", "PENALTY_EVENT"]
          },
          "text": {"type": "string", "minLength": 1},
          "start": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 0},
          "normalized": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "violation_category": {
      "type": "string",
      "enum": ["FORGED_INSPECTION_REPORT", "TAMPERED_TRACEABILITY", "FAKE_CERTIFICATION", "FALSE_LABELING", "UNLICENSED_OPERATION", "OTHER"]
    },
    "case_outcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "penalty_types": {"type": "array", "items": {"type": "string"}},
        "fine_amount_cny": {"type": ["number", "null"]},
        "decision_date": {"type": ["string", "null"]}
      }
    },
    "evidence_spans": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
